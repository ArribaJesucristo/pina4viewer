<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Pina4Viewer" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/gold_primary</item>
        <item name="colorPrimaryVariant">@color/gold_dark</item>
        <item name="colorOnPrimary">@color/background_dark</item>
        <item name="colorSecondary">@color/gold_accent</item>
        <item name="colorOnSecondary">@color/background_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>

        <!-- Diálogos Material oscuros con foco dorado -->
        <item name="materialAlertDialogTheme">@style/Theme.Pina4Viewer.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.Pina4Viewer.Dialog</item>

        <!-- Menú emergente de Toolbar oscuro con foco dorado -->
        <item name="popupMenuStyle">@style/Theme.Pina4Viewer.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Theme.Pina4Viewer.PopupMenu</item>
    </style>

    <!-- Tema oscuro de Diálogos con alto contraste para TV -->
    <style name="Theme.Pina4Viewer.Dialog" parent="ThemeOverlay.MaterialComponents.MaterialAlertDialog">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorBackgroundFloating">@color/surface_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="materialAlertDialogTitleTextStyle">@style/Theme.Pina4Viewer.Dialog.Title</item>
        <item name="buttonBarPositiveButtonStyle">@style/Theme.Pina4Viewer.Dialog.Button</item>
        <item name="buttonBarNegativeButtonStyle">@style/Theme.Pina4Viewer.Dialog.Button</item>
        <item name="buttonBarNeutralButtonStyle">@style/Theme.Pina4Viewer.Dialog.Button</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:listSelector">@drawable/selector_dialog_item_focus</item>
        <item name="listChoiceBackgroundIndicator">@drawable/selector_dialog_item_focus</item>
    </style>

    <style name="Theme.Pina4Viewer.Dialog.Title" parent="MaterialAlertDialog.MaterialComponents.Title.Text">
        <item name="android:textColor">@color/gold_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">19sp</item>
    </style>

    <style name="Theme.Pina4Viewer.Dialog.Button" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="backgroundTint">@color/selector_dialog_button_bg</item>
        <item name="strokeColor">@color/selector_dialog_button_stroke</item>
        <item name="strokeWidth">2.5dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="rippleColor">#55FFFFFF</item>
        <item name="android:textColor">@color/selector_dialog_button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="android:minWidth">88dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:layout_marginEnd">6dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:layout_marginBottom">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="elevation">0dp</item>
    </style>

    <!-- Tema del menú emergente de la Toolbar -->
    <style name="Theme.Pina4Viewer.ToolbarPopup" parent="ThemeOverlay.MaterialComponents.Dark">
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorBackgroundFloating">@color/surface_dark</item>
        <item name="android:colorBackground">@color/surface_dark</item>
        <item name="android:textColor">@color/selector_dialog_item_text</item>
        <item name="android:textColorPrimary">@color/selector_dialog_item_text</item>
        <item name="colorControlHighlight">#55FFD700</item>
        <item name="android:listSelector">@drawable/selector_dialog_item_focus</item>
        <item name="listChoiceBackgroundIndicator">@drawable/selector_dialog_item_focus</item>
        <item name="popupMenuStyle">@style/Theme.Pina4Viewer.PopupMenu</item>
        <item name="actionOverflowMenuStyle">@style/Theme.Pina4Viewer.PopupMenu</item>
    </style>

    <style name="Theme.Pina4Viewer.PopupMenu" parent="Widget.MaterialComponents.PopupMenu">
        <item name="android:popupBackground">@drawable/bg_popup_menu</item>
        <item name="android:dropDownSelector">@drawable/selector_dialog_item_focus</item>
    </style>
</resources>

