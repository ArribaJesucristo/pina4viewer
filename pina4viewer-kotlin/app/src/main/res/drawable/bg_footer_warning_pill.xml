<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFA726" />
            <stroke android:width="2.5dp" android:color="@color/gold_primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#40FFA726" />
            <stroke android:width="1.5dp" android:color="@color/gold_primary" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/warning_amber_bg" />
            <stroke android:width="1dp" android:color="@color/warning_amber_border" />
            <corners android:radius="8dp" />
        </shape>
    </item>
</selector>
