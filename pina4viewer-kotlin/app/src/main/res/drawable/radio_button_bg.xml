<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_primary" />
            <stroke android:width="2.5dp" android:color="#FFFFFF" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/card_focused" />
            <stroke android:width="2.5dp" android:color="@color/gold_primary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/gold_primary" />
            <corners android:radius="9dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="9dp" />
        </shape>
    </item>
</selector>
