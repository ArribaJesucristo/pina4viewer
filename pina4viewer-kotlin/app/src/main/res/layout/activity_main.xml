<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Contenido Principal (Vista Vertical / Móvil) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- Top Command Bar Obsidian -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/toolbar_height"
            android:background="@color/surface_dark"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:contentInsetStartWithNavigation="0dp"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:contentInsetStart="0dp"
            app:layout_constraintTop_toTopOf="parent"
            app:popupTheme="@style/Theme.Pina4Viewer.ToolbarPopup"
            app:title="">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="start|center_vertical"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivToolbarLogo"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:adjustViewBounds="true"
                    android:contentDescription="Piña4Viewer"
                    android:src="@mipmap/logo_actionbar" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvToolbarBrand"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.04"
                        android:maxLines="1"
                        android:text="PIÑA4VIEWER"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/toolbar_brand_text_size"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvUserCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="Cargando programación..."
                        android:textColor="@color/live_green"
                        android:textSize="@dimen/status_banner_text_size"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnToolbarRefresh"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_toolbar_icon_btn"
                android:clickable="true"
                android:contentDescription="Actualizar agenda"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_refresh" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Barra de Controles (Fuentes + Búsqueda apiladas en móvil) -->
        <LinearLayout
            android:id="@+id/controlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/control_horizontal_margin"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/toolbar">

            <RadioGroup
                android:id="@+id/radioGroupSources"
                android:layout_width="match_parent"
                android:layout_height="@dimen/source_tab_height"
                android:background="@drawable/bg_segmented_container"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:padding="3dp">

                <RadioButton
                    android:id="@+id/rbPina"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_bg"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:nextFocusDown="@+id/etSearch"
                    android:text="🍍 PIÑAVISION"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/source_tab_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbTv"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/etSearch"
                    android:text="📺 24/7 TV"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/source_tab_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/rbCaido"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/radio_button_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/etSearch"
                    android:text="⚡ CAIDO"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/source_tab_text_size"
                    android:textStyle="bold" />
            </RadioGroup>

            <!-- Buscador con botón limpiar -->
            <FrameLayout
                android:id="@+id/searchContainer"
                android:layout_width="match_parent"
                android:layout_height="@dimen/search_box_height"
                android:layout_marginTop="6dp"
                android:clipChildren="false"
                android:clipToPadding="false">

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/search_input_bg"
                    android:hint="🔍 Buscar equipo, competición o canal..."
                    android:imeOptions="actionSearch|flagNoExtractUi"
                    android:inputType="text"
                    android:nextFocusDown="@id/chipSportAll"
                    android:nextFocusUp="@id/rbPina"
                    android:paddingStart="14dp"
                    android:paddingEnd="38dp"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/search_box_text_size" />

                <ImageButton
                    android:id="@+id/btnClearSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/selector_dialog_item_focus"
                    android:clickable="true"
                    android:contentDescription="Limpiar búsqueda"
                    android:focusable="true"
                    android:padding="6dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>

        <!-- Chips de Filtro Deportivo + En Directo -->
        <HorizontalScrollView
            android:id="@+id/scrollSportChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/control_horizontal_margin"
            android:layout_marginTop="6dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:scrollbars="none"
            app:layout_constraintTop_toBottomOf="@id/controlBar">

            <RadioGroup
                android:id="@+id/radioGroupSports"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_bar_height"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/chipSportAll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:checked="true"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="🏆 Todos"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportLive"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_live_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="● En Directo"
                    android:textColor="@color/chip_live_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportFutbol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="⚽ Fútbol"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportTenis"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="🎾 Tenis / Pádel"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportMotor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="🏎️ Motor"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportBasket"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="🏀 Basket"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />

                <RadioButton
                    android:id="@+id/chipSportOtros"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:nextFocusDown="@+id/recyclerViewEvents"
                    android:nextFocusUp="@+id/etSearch"
                    android:paddingHorizontal="12dp"
                    android:text="🥊 Otros"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold" />
            </RadioGroup>
        </HorizontalScrollView>

        <!-- Lista / Grid de Eventos con SwipeRefresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            app:layout_constraintBottom_toTopOf="@id/layoutFooter"
            app:layout_constraintTop_toBottomOf="@id/scrollSportChips">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:descendantFocusability="afterDescendants">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewEvents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="true"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:nextFocusDown="@id/tvFooterWarning"
                    android:nextFocusUp="@id/chipSportAll"
                    android:paddingHorizontal="4dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="8dp"
                    tools:listitem="@layout/item_event" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/empty_events"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/card_title_text_size"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Footer Compacto -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvFooterWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_footer_warning_pill"
                android:clickable="true"
                android:ellipsize="end"
                android:focusable="true"
                android:maxLines="1"
                android:nextFocusUp="@id/recyclerViewEvents"
                android:paddingHorizontal="10dp"
                android:paddingVertical="5dp"
                android:text="⚠️ ¿Cannot get transport file? Pulsa aquí para guía VPN"
                android:textColor="@color/warning_amber"
                android:textSize="@dimen/footer_text_size"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvFooterZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Actualizado --:--"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/footer_text_size"
                android:textStyle="bold" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Panel Lateral (Canales Directos AV) -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_dark"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:contentDescription="Logo"
                android:src="@mipmap/logo_actionbar" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Canales Directos"
                    android:textColor="@color/gold_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ArenaVision AV1 – AV160"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <ListView
            android:id="@+id/drawerChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@color/divider_color"
            android:dividerHeight="1dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/selector_dialog_item_focus"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
