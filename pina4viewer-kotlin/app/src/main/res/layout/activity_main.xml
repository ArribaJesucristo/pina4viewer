<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Main Content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/background_dark"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- Toolbar / Action Bar with Centered Logo -->
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/surface_dark"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
            app:popupTheme="@style/Theme.Pina4Viewer.ToolbarPopup"
            app:layout_constraintTop_toTopOf="parent"
            app:title="">

            <ImageView
                android:id="@+id/ivToolbarLogo"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:contentDescription="Piña4Viewer"
                android:adjustViewBounds="true"
                android:src="@mipmap/logo_actionbar" />

        </androidx.appcompat.widget.Toolbar>

        <!-- Event Status Banner -->
        <TextView
            android:id="@+id/tvUserCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:text="Cargando programación deportiva..."
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/status_banner_text_size"
            android:textStyle="bold|italic"
            app:layout_constraintTop_toBottomOf="@id/toolbar" />

        <!-- Radio Buttons Main Sources -->
        <RadioGroup
            android:id="@+id/radioGroupSources"
            android:layout_width="match_parent"
            android:layout_height="@dimen/source_tab_height"
            android:layout_marginHorizontal="@dimen/control_horizontal_margin"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tvUserCount">

            <RadioButton
                android:id="@+id/rbPina"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/radio_button_bg"
                android:button="@null"
                android:checked="true"
                android:gravity="center"
                android:text="🍍 PIÑAVISION"
                android:textColor="@color/radio_text_color"
                android:textSize="@dimen/source_tab_text_size"
                android:textStyle="bold|italic"
                android:nextFocusDown="@+id/etSearch" />

            <RadioButton
                android:id="@+id/rbTv"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/radio_button_bg"
                android:button="@null"
                android:gravity="center"
                android:text="📺 24/7 TV"
                android:textColor="@color/radio_text_color"
                android:textSize="@dimen/source_tab_text_size"
                android:textStyle="bold|italic"
                android:nextFocusDown="@+id/etSearch" />

            <RadioButton
                android:id="@+id/rbCaido"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:background="@drawable/radio_button_bg"
                android:button="@null"
                android:gravity="center"
                android:text="⚡ CAIDO"
                android:textColor="@color/radio_text_color"
                android:textSize="@dimen/source_tab_text_size"
                android:textStyle="bold|italic"
                android:nextFocusDown="@+id/etSearch" />
        </RadioGroup>

        <!-- Search Input Box -->
        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/search_box_height"
            android:layout_marginHorizontal="@dimen/control_horizontal_margin"
            android:layout_marginTop="4dp"
            android:background="@drawable/search_input_bg"
            android:hint="🔍 Buscar evento o canal..."
            android:imeOptions="actionSearch|flagNoExtractUi"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_hint"
            android:textSize="@dimen/search_box_text_size"
            android:nextFocusUp="@id/rbPina"
            android:nextFocusDown="@id/chipSportAll"
            app:layout_constraintTop_toBottomOf="@id/radioGroupSources" />

        <!-- Sport Filter Chips (Horizontal Scroll) -->
        <HorizontalScrollView
            android:id="@+id/scrollSportChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/control_horizontal_margin"
            android:layout_marginTop="4dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            app:layout_constraintTop_toBottomOf="@id/etSearch">

            <RadioGroup
                android:id="@+id/radioGroupSports"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/chip_bar_height"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/chipSportAll"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="🏆 Todos"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:checked="true"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

                <RadioButton
                    android:id="@+id/chipSportFutbol"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="⚽ Fútbol"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

                <RadioButton
                    android:id="@+id/chipSportTenis"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="🎾 Tenis / Pádel"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

                <RadioButton
                    android:id="@+id/chipSportMotor"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="🏎️ Motor"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

                <RadioButton
                    android:id="@+id/chipSportBasket"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="🏀 Basket"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

                <RadioButton
                    android:id="@+id/chipSportOtros"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:paddingHorizontal="12dp"
                    android:background="@drawable/chip_sport_bg"
                    android:button="@null"
                    android:gravity="center"
                    android:text="🥊 Otros"
                    android:textColor="@color/radio_text_color"
                    android:textSize="@dimen/chip_text_size"
                    android:textStyle="bold"
                    android:nextFocusUp="@+id/etSearch"
                    android:nextFocusDown="@+id/recyclerViewEvents" />

            </RadioGroup>
        </HorizontalScrollView>

        <!-- Event List with Pull to Refresh -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            app:layout_constraintBottom_toTopOf="@id/layoutFooter"
            app:layout_constraintTop_toBottomOf="@id/scrollSportChips">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerViewEvents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingVertical="4dp"
                    android:focusable="false"
                    android:descendantFocusability="afterDescendants"
                    android:nextFocusUp="@id/chipSportAll"
                    android:nextFocusDown="@id/tvFooterWarning"
                    tools:listitem="@layout/item_event" />

                <TextView
                    android:id="@+id/tvEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:padding="24dp"
                    android:text="@string/empty_events"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/card_title_text_size"
                    android:visibility="gone" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Bottom Footer (Left Warning, Right Workflow Update) -->
        <LinearLayout
            android:id="@+id/layoutFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:background="@color/surface_dark"
            app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                android:id="@+id/tvFooterWarning"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/selector_dialog_item_focus"
                android:clickable="true"
                android:focusable="true"
                android:padding="6dp"
                android:text="⚠️ Si al cargar un partido te sale cannot get transport file, enciende la vpn (pulsa aquí para ayuda)"
                android:textColor="#FFA726"
                android:textSize="@dimen/footer_text_size"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:nextFocusUp="@id/recyclerViewEvents"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvFooterZone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Actualizado:\n--/-- --:--"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/footer_text_size"
                android:textStyle="bold|italic" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Side Navigation Drawer (Direct Channels & Social Media) -->
    <LinearLayout
        android:id="@+id/navigationDrawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/surface_dark"
        android:orientation="vertical">

        <!-- Drawer Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Logo"
                android:src="@mipmap/logo_actionbar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Canales Directos"
                android:textColor="@color/gold_primary"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/divider_color" />

        <!-- Direct Channels List -->
        <ListView
            android:id="@+id/drawerChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:divider="@color/divider_color"
            android:dividerHeight="1dp"
            android:drawSelectorOnTop="false"
            android:listSelector="@drawable/selector_dialog_item_focus"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
